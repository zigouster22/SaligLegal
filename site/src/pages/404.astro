---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" description="The page you were looking for could not be found." noindex>
  <div class="page-hero">
    <div class="wrap not-found">
      <div class="eyebrow">Error 404</div>
      <h1>We couldn’t find that page.</h1>
      <p>The link may be out of date, or the address may have a typo.</p>
      <div class="actions"><a class="button" href="/">Go to the home page</a><a class="button outline" href="/contact/">Contact us</a></div>
    </div>
  </div>
</Base>
